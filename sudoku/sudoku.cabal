cabal-version:   3.0
name:            sudoku
version:         0.1.0.0
license:         BSD-3-Clause
license-file:    LICENSE
maintainer:      elias.carotti+git@gmail.com
author:          Elias Carotti
build-type:      Simple
extra-doc-files: CHANGELOG.md

executable sudoku
